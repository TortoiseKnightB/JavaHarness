# ================================================================
# java-tiny-claw 应用配置
# ================================================================

provider:
  # --- OpenAI 兼容协议（当前使用） ---
  type: openai
  model: glm-4.5-air
  api-key: ${ZHIPU_API_KEY:}
  base-url: https://open.bigmodel.cn/api/paas/v4/

  # --- Claude（Anthropic）协议配置 ---
  # Zhipu 的 Anthropic 端点路径在测试时返回 404，如有正确端点可启用
  #type: claude
  #model: glm-4.5-air
  #api-key: ${ZHIPU_API_KEY:...}
  #base-url: https://open.bigmodel.cn/api/paas/v4/

engine:
  # 慢思考模式：复杂任务开启，简单任务关闭以节省 Token
  enable-thinking: false
  # 计划模式：开启时注入 PLAN.md / TODO.md 状态外部化规范
  plan-mode: false
  # 工作目录：Agent 的物理边界（默认当前目录）
  work-dir: ./workspace

server:
  # 启动模式：cli（命令行）| feishu（飞书长连接）
  mode: cli

feishu:
  # 飞书企业自建应用的 App ID 和 App Secret
  app-id: ${FEISHU_APP_ID:}
  app-secret: ${FEISHU_APP_SECRET:}
